<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="v1.2.0-refactor-sailpoint-id-to-attempt" author="maxgarsaiz">
        <comment>
            Move sailpoint_request_id from access_request to access_request_attempt.
            Each attempt will have its own Sailpoint access request ID.
            Also remove access_type column from access_request.
        </comment>

        <!-- Add sailpoint_access_request_id to access_request_attempt -->
        <addColumn tableName="access_request_attempt">
            <column name="sailpoint_access_request_id" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
        </addColumn>

        <!-- Create index on sailpoint_access_request_id -->
        <createIndex indexName="idx_attempt_sailpoint_id" tableName="access_request_attempt">
            <column name="sailpoint_access_request_id"/>
        </createIndex>

        <!-- Drop old index on access_request.sailpoint_request_id -->
        <dropIndex tableName="access_request" indexName="idx_access_request_sailpoint_id"/>

        <!-- Drop sailpoint_request_id column from access_request -->
        <dropColumn tableName="access_request" columnName="sailpoint_request_id"/>

        <!-- Drop access_type column from access_request (no longer needed) -->
        <dropColumn tableName="access_request" columnName="access_type"/>
    </changeSet>

</databaseChangeLog>
